#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
DEBUG=false
XFIND_FILENAME_COLOR=''
XFIND_SEPARATOR_COLOR=''
XFIND_COLOR_RESET=''
XFIND_GREP_COLOR_MODE=auto
INCLUDE_TYPES=()
EXCLUDE_TYPES=()
INCLUDE_PATHS=()
EXCLUDE_PATHS=(.git node_modules)
TERMS=()
AND_TERMS=()
OR_TERMS=()
NOT_TERMS=()
HIGHLIGHT_TERMS=()
FIND_ARGUMENTS=()
SEARCH_TERM_COUNT=0

if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = 'dumb' ]; then
  XFIND_GREP_COLOR_MODE=never
elif [ -t 1 ]; then
  XFIND_FILENAME_COLOR=$'\033[35m'
  XFIND_SEPARATOR_COLOR=$'\033[36m'
  XFIND_COLOR_RESET=$'\033[0m'
fi

print_help() {
  cat <<HELP
Usage:
  $SCRIPT_NAME [options] [<term>...]

Boolean terms:
  Terms are required by default and are combined with AND.
  and  Add following terms to the required group.
  or   Add following terms to a single OR group.
  not  Add following terms to a single excluded OR group.

Options:
  -d, --debug                 Print the command without running it.
      --no-debug              Disable debug mode set by .xfind.
  -h, --help                  Show this help message.
  -t, --include-type TYPE     Include a file extension.
  -T, --exclude-type TYPE     Exclude a file extension.
  -p, --include-path PATH     Include files beneath a directory.
  -P, --exclude-path PATH     Exclude files beneath a directory.

Examples:
  $SCRIPT_NAME
  $SCRIPT_NAME foo
  $SCRIPT_NAME foo bar
  $SCRIPT_NAME foo or bar baz not generated vendor
  $SCRIPT_NAME foo -t js -T spec.js
  $SCRIPT_NAME foo -p src -p lib
  $SCRIPT_NAME foo -P spec

Defaults:
  The .git and node_modules directories are excluded.
  If .xfind exists in the current directory, its whitespace-separated options
  and terms are prepended to the command line.

Environment:
  A nonempty NO_COLOR disables colored output.
HELP
}

die() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
  exit 2
}

load_project_arguments() {
  local token

  PROJECT_ARGUMENTS=()
  if [ -f ./.xfind ]; then
    while IFS= read -r token; do
      [ -n "$token" ] && PROJECT_ARGUMENTS+=("$token")
    done < <(tr -s '[:space:]' '\n' < ./.xfind)
  fi

  PROJECT_ARGUMENTS+=("$@")
}

read_option_value() {
  local option="$1"
  local argument="$2"
  local remaining="$3"

  if [[ "$argument" == *=* ]]; then
    OPTION_VALUE="${argument#*=}"
    OPTION_SHIFT=1
  else
    if [ "$remaining" -lt 2 ]; then
      die "$option requires a value"
    fi
    OPTION_VALUE="$4"
    OPTION_SHIFT=2
  fi
}

append_filter_value() {
  local kind="$1"
  local value="$2"

  case "$kind" in
    include-path)
      INCLUDE_PATHS+=("$value")
      ;;
    exclude-path)
      EXCLUDE_PATHS+=("$value")
      ;;
    include-type)
      INCLUDE_TYPES+=("$value")
      ;;
    exclude-type)
      EXCLUDE_TYPES+=("$value")
      ;;
  esac
}

parse_arguments() {
  local argument kind option

  while [ "$#" -gt 0 ]; do
    argument="$1"
    option="${argument%%=*}"

    case "$argument" in
      -d|--debug)
        DEBUG=true
        shift
        ;;
      --no-debug)
        DEBUG=false
        shift
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      -p|--include-path|--include-path=*|\
      -P|--exclude-path|--exclude-path=*|\
      -t|--include-type|--include-type=*|\
      -T|--exclude-type|--exclude-type=*)
        read_option_value "$option" "$argument" "$#" "${2-}"
        case "$option" in
          -p|--include-path) kind=include-path ;;
          -P|--exclude-path) kind=exclude-path ;;
          -t|--include-type) kind=include-type ;;
          -T|--exclude-type) kind=exclude-type ;;
        esac
        append_filter_value "$kind" "$OPTION_VALUE"
        shift "$OPTION_SHIFT"
        ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do
          TERMS+=("$1")
          shift
        done
        ;;
      -*)
        die "unknown option: $argument"
        ;;
      *)
        TERMS+=("$argument")
        shift
        ;;
    esac
  done
}

append_term() {
  local group="$1"
  local term="$2"

  case "$group" in
    and)
      AND_TERMS+=("$term")
      ;;
    or)
      OR_TERMS+=("$term")
      ;;
    not)
      NOT_TERMS+=("$term")
      ;;
  esac
}

classify_terms() {
  local current_group=and
  local stripped term

  for term in "${TERMS[@]}"; do
    case "$term" in
      and|or|not)
        current_group="$term"
        continue
        ;;
    esac

    stripped="$term"
    if [[ "$stripped" == -* ]]; then
      while [[ "$stripped" == -* ]]; do
        stripped="${stripped#-}"
      done

      case "$stripped" in
        [aA][nN][dD]|[oO][rR]|[nN][oO][tT])
          term="$stripped"
          ;;
      esac
    fi

    append_term "$current_group" "$term"
  done

  SEARCH_TERM_COUNT="$((${#AND_TERMS[@]} + ${#OR_TERMS[@]} + ${#NOT_TERMS[@]}))"
  if [ "${#TERMS[@]}" -gt 0 ] && [ "$SEARCH_TERM_COUNT" -eq 0 ]; then
    die 'at least one search term is required'
  fi

  HIGHLIGHT_TERMS=("${AND_TERMS[@]}" "${OR_TERMS[@]}")
}

is_simple_search() {
  [ "${#AND_TERMS[@]}" -eq 1 ] &&
    [ "${#OR_TERMS[@]}" -eq 0 ] &&
    [ "${#NOT_TERMS[@]}" -eq 0 ]
}

append_include_group() {
  local predicate="$1"
  local prefix="$2"
  shift 2

  local first=true value

  [ "$#" -gt 0 ] || return 0

  FIND_ARGUMENTS+=("(")
  for value in "$@"; do
    if $first; then
      first=false
    else
      FIND_ARGUMENTS+=(-o)
    fi
    FIND_ARGUMENTS+=("$predicate" "${prefix}${value}")
  done
  FIND_ARGUMENTS+=(")")
}

append_exclusions() {
  local predicate="$1"
  local prefix="$2"
  shift 2

  local value

  for value in "$@"; do
    FIND_ARGUMENTS+=(! "$predicate" "${prefix}${value}")
  done
}

build_find_arguments() {
  local path

  FIND_ARGUMENTS=(. -type f)

  append_include_group -name '*.' "${INCLUDE_TYPES[@]}"
  append_exclusions -name '*.' "${EXCLUDE_TYPES[@]}"

  if [ "${#INCLUDE_PATHS[@]}" -gt 0 ]; then
    FIND_ARGUMENTS+=("(")
    for path in "${INCLUDE_PATHS[@]}"; do
      if [ "${FIND_ARGUMENTS[${#FIND_ARGUMENTS[@]} - 1]}" != "(" ]; then
        FIND_ARGUMENTS+=(-o)
      fi
      FIND_ARGUMENTS+=(-path "*/$path/*")
    done
    FIND_ARGUMENTS+=(")")
  fi

  append_exclusions -path '*/' "${EXCLUDE_PATHS[@]/%//\*}"
  FIND_ARGUMENTS+=(-print)
}

print_argument() {
  printf ' %q' "$1"
}

print_grep_group() {
  local invert="$1"
  local color="$2"
  local term
  shift 2

  printf ' | grep'
  $invert && printf ' -v'
  $color && printf ' --color=%s' "$XFIND_GREP_COLOR_MODE"
  for term in "$@"; do
    printf ' -e'
    print_argument "$term"
  done
}

print_debug_command() {
  local argument index

  printf 'find'
  for argument in "${FIND_ARGUMENTS[@]}"; do
    print_argument "$argument"
  done
  printf ' | sort'

  if is_simple_search; then
    printf ' | xargs grep --color=%s -H --' "$XFIND_GREP_COLOR_MODE"
    print_argument "${AND_TERMS[0]}"
  elif [ "$SEARCH_TERM_COUNT" -gt 0 ]; then
    printf ' | while IFS= read -r file; do '
    if [ "${#AND_TERMS[@]}" -gt 0 ]; then
      printf 'grep --'
      print_argument "${AND_TERMS[0]}"
      printf ' < "$file"'
      for ((index = 1; index < ${#AND_TERMS[@]}; index++)); do
        printf ' | grep --'
        print_argument "${AND_TERMS[index]}"
      done
    else
      printf 'cat < "$file"'
    fi
    [ "${#OR_TERMS[@]}" -eq 0 ] || print_grep_group false false "${OR_TERMS[@]}"
    [ "${#NOT_TERMS[@]}" -eq 0 ] || print_grep_group true false "${NOT_TERMS[@]}"
    printf ' | while IFS= read -r line; do printf "%%s:%%s\\n" "$file" "$line"; done; done'
    [ "${#HIGHLIGHT_TERMS[@]}" -eq 0 ] ||
      print_grep_group false true "${HIGHLIGHT_TERMS[@]}"
  fi
  printf '\n'
}

grep_batch() {
  command grep --color="$XFIND_GREP_COLOR_MODE" -H -- \
    "${AND_TERMS[0]}" "${FILE_BATCH[@]}"
}

grep_sorted_files() {
  local file status
  local matched=false
  local -a FILE_BATCH=()

  while IFS= read -r file; do
    FILE_BATCH+=("$file")
    if [ "${#FILE_BATCH[@]}" -eq 100 ]; then
      if grep_batch; then
        matched=true
      else
        status=$?
        [ "$status" -eq 1 ] || return "$status"
      fi
      FILE_BATCH=()
    fi
  done < <(command find "${FIND_ARGUMENTS[@]}" | command sort)

  if [ "${#FILE_BATCH[@]}" -gt 0 ]; then
    if grep_batch; then
      matched=true
    else
      status=$?
      [ "$status" -eq 1 ] || return "$status"
    fi
  fi

  $matched
}

filter_and_terms() {
  local file="$1"
  local index="$2"

  if [ "$index" -eq 0 ]; then
    command grep -- "${AND_TERMS[0]}" < "$file"
  else
    filter_and_terms "$file" "$((index - 1))" |
      command grep -- "${AND_TERMS[index]}"
  fi
}

grep_group() {
  local invert="$1"
  local term
  local -a arguments=(grep)
  shift

  $invert && arguments+=(-v)
  for term in "$@"; do
    arguments+=(-e "$term")
  done

  command "${arguments[@]}"
}

filter_and_stage() {
  local file="$1"

  if [ "${#AND_TERMS[@]}" -gt 0 ]; then
    filter_and_terms "$file" "$((${#AND_TERMS[@]} - 1))"
  else
    command cat < "$file"
  fi
}

filter_or_stage() {
  local file="$1"

  if [ "${#OR_TERMS[@]}" -gt 0 ]; then
    filter_and_stage "$file" | grep_group false "${OR_TERMS[@]}"
  else
    filter_and_stage "$file"
  fi
}

filter_file() {
  local file="$1"

  if [ "${#NOT_TERMS[@]}" -gt 0 ]; then
    filter_or_stage "$file" | grep_group true "${NOT_TERMS[@]}"
  else
    filter_or_stage "$file"
  fi
}

prefix_lines() {
  local file="$1"
  local line

  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s%s%s:%s%s\n' \
      "$XFIND_FILENAME_COLOR" "$file" "$XFIND_SEPARATOR_COLOR" \
      "$XFIND_COLOR_RESET" "$line"
  done
}

grep_multiple_files() {
  local file status
  local matched=false

  while IFS= read -r file; do
    if filter_file "$file" | prefix_lines "$file"; then
      matched=true
    else
      status=$?
      [ "$status" -eq 1 ] || return "$status"
    fi
  done < <(command find "${FIND_ARGUMENTS[@]}" | command sort)

  $matched
}

highlight_results() {
  local term
  local -a arguments=(grep --color="$XFIND_GREP_COLOR_MODE")

  for term in "${HIGHLIGHT_TERMS[@]}"; do
    arguments+=(-e "$term")
  done

  command "${arguments[@]}"
}

run_find() {
  printf '\n'

  if $DEBUG; then
    print_debug_command
  elif [ "$SEARCH_TERM_COUNT" -eq 0 ]; then
    command find "${FIND_ARGUMENTS[@]}" | command sort
  elif is_simple_search; then
    grep_sorted_files
  elif [ "${#HIGHLIGHT_TERMS[@]}" -gt 0 ]; then
    grep_multiple_files | highlight_results
  else
    grep_multiple_files
  fi
}

main() {
  load_project_arguments "$@"
  parse_arguments "${PROJECT_ARGUMENTS[@]}"
  classify_terms
  build_find_arguments
  run_find
}

main "$@"
