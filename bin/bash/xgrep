#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
XGREP_ENGINE_DIR="$(cd "$SCRIPT_DIR/../../lib/bash/xgrep" && pwd)"

DEBUG=false
FILES_WITH_MATCHES=false
FZF_PREVIEW_COMMAND='head -n 200 {}'
IGNORE_CASE=false
INCLUDE_TYPES=()
EXCLUDE_TYPES=()
INCLUDE_PATHS=()
EXCLUDE_PATHS=()
TERMS=()
AND_TERMS=()
OR_TERMS=()
NOT_TERMS=()
NO_PAGER=false
SEARCH_TERM_COUNT=0
SEARCH_ENGINE=''
USE_FZF=false
USE_PAGER=false

print_help() {
  cat <<HELP
Usage:
  $SCRIPT_NAME [options] <term>...

Search engine:
  Inside a Git work tree, search tracked files with git grep.
  Otherwise, search files beneath the current directory with find and grep.

Boolean terms:
  Terms are required by default and are combined with AND.
  and  Add following terms to the required group.
  or   Add following terms to a single OR group.
  not  Add following terms to a single excluded OR group.

Patterns:
  Search terms use extended regular expressions.
  Binary files are ignored.

Options:
  -d, --debug                 Print the search command without running it.
      --no-debug              Disable debug mode, including one set by .xgrep.
      --no-pager              Disable filesystem-result paging.
      --fzf                   Select a matching file with fzf and open it.
  -h, --help                  Show this help message.
  -i, --ignore-case           Ignore case distinctions.
  -l, --files-with-matches    Show only names of files containing matches.
  -p, --include-path PATH     Include a directory path at any depth.
  -P, --exclude-path PATH     Exclude a directory path at any depth.
  -t, --include-type TYPE     Include a file extension.
  -T, --exclude-type TYPE     Exclude a file extension.

Examples:
  $SCRIPT_NAME alpha beta
  $SCRIPT_NAME --fzf alpha beta
  $SCRIPT_NAME -l alpha beta
  $SCRIPT_NAME or alpha beta
  $SCRIPT_NAME alpha or beta gamma not generated vendor
  $SCRIPT_NAME -p src -p lib -t rb -t sh alpha
  $SCRIPT_NAME -T min.js not generated

Project defaults:
  If .xgrep exists in the current directory, its whitespace-separated options
  and terms are prepended to the command line.

Environment:
  A nonempty NO_COLOR disables colored output.
  LESS configures the filesystem pager; the default is FRX.
  PAGER=cat disables filesystem paging.
  bat or batcat adds syntax highlighting to the fzf preview when available.
  VISUAL or EDITOR selects the editor used by --fzf; the default is vi.
HELP
}

die() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
  exit 2
}

load_project_arguments() {
  local token

  PROJECT_ARGUMENTS=()
  if [ -f ./.xgrep ]; then
    while IFS= read -r token; do
      [ -n "$token" ] && PROJECT_ARGUMENTS+=("$token")
    done < <(tr -s '[:space:]' '\n' < ./.xgrep)
  fi

  PROJECT_ARGUMENTS+=("$@")
}

read_option_value() {
  local option="$1"
  local argument="$2"
  local remaining="$3"

  if [[ "$argument" == *=* ]]; then
    OPTION_VALUE="${argument#*=}"
    OPTION_SHIFT=1
  else
    if [ "$remaining" -lt 2 ]; then
      die "$option requires a value"
    fi
    OPTION_VALUE="$4"
    OPTION_SHIFT=2
  fi
}

append_filter_value() {
  local kind="$1"
  local value="$2"

  case "$kind" in
    include-path)
      INCLUDE_PATHS+=("$value")
      ;;
    exclude-path)
      EXCLUDE_PATHS+=("$value")
      ;;
    include-type)
      INCLUDE_TYPES+=("$value")
      ;;
    exclude-type)
      EXCLUDE_TYPES+=("$value")
      ;;
  esac
}

parse_arguments() {
  local argument kind option

  while [ "$#" -gt 0 ]; do
    argument="$1"
    option="${argument%%=*}"

    case "$argument" in
      -d|--debug)
        DEBUG=true
        shift
        ;;
      --no-debug)
        DEBUG=false
        shift
        ;;
      --no-pager)
        NO_PAGER=true
        shift
        ;;
      --fzf)
        USE_FZF=true
        FILES_WITH_MATCHES=true
        shift
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      -i|--ignore-case)
        IGNORE_CASE=true
        shift
        ;;
      -l|--files-with-matches)
        FILES_WITH_MATCHES=true
        shift
        ;;
      -p|--include-path|--include-path=*|\
      -P|--exclude-path|--exclude-path=*|\
      -t|--include-type|--include-type=*|\
      -T|--exclude-type|--exclude-type=*)
        read_option_value "$option" "$argument" "$#" "${2-}"
        case "$option" in
          -p|--include-path) kind=include-path ;;
          -P|--exclude-path) kind=exclude-path ;;
          -t|--include-type) kind=include-type ;;
          -T|--exclude-type) kind=exclude-type ;;
        esac
        append_filter_value "$kind" "$OPTION_VALUE"
        shift "$OPTION_SHIFT"
        ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do
          TERMS+=("$1")
          shift
        done
        ;;
      -*)
        die "unknown option: $argument"
        ;;
      *)
        TERMS+=("$argument")
        shift
        ;;
    esac
  done
}

build_fzf_preview_command() {
  $USE_FZF || return 0

  if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = 'dumb' ]; then
    return 0
  elif command -v bat >/dev/null 2>&1; then
    FZF_PREVIEW_COMMAND='bat --color=always --style=numbers --line-range=:200 -- {}'
  elif command -v batcat >/dev/null 2>&1; then
    FZF_PREVIEW_COMMAND='batcat --color=always --style=numbers --line-range=:200 -- {}'
  fi
}

append_term() {
  local group="$1"
  local term="$2"

  case "$group" in
    and)
      AND_TERMS+=("$term")
      ;;
    or)
      OR_TERMS+=("$term")
      ;;
    not)
      NOT_TERMS+=("$term")
      ;;
  esac
}

classify_terms() {
  local current_group=and
  local stripped term

  for term in "${TERMS[@]}"; do
    case "$term" in
      and|or|not)
        current_group="$term"
        continue
        ;;
    esac

    stripped="$term"
    if [[ "$stripped" == -* ]]; then
      while [[ "$stripped" == -* ]]; do
        stripped="${stripped#-}"
      done

      case "$stripped" in
        [aA][nN][dD]|[oO][rR]|[nN][oO][tT])
          term="$stripped"
          ;;
      esac
    fi

    append_term "$current_group" "$term"
  done

  SEARCH_TERM_COUNT="$((${#AND_TERMS[@]} + ${#OR_TERMS[@]} + ${#NOT_TERMS[@]}))"
  if [ "$SEARCH_TERM_COUNT" -eq 0 ]; then
    die 'at least one search term is required'
  fi
}

load_search_engine() {
  local engine_file

  if command git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    SEARCH_ENGINE=git
  else
    SEARCH_ENGINE=find
  fi

  configure_pager
  engine_file="$XGREP_ENGINE_DIR/$SEARCH_ENGINE.sh"
  if [ ! -r "$engine_file" ]; then
    die "search engine is unavailable: $engine_file"
  fi

  # The selected engine defines build_engine_arguments, print_engine_command,
  # and run_engine.
  . "$engine_file"
}

configure_pager() {
  USE_PAGER=false

  [ "$SEARCH_ENGINE" = find ] || return 0
  $NO_PAGER && return 0
  $DEBUG && return 0
  $USE_FZF && return 0
  [ -t 1 ] || return 0
  [ "${TERM:-}" != dumb ] || return 0

  case "${PAGER:-}" in
    cat|*/cat)
      return 0
      ;;
  esac

  command -v less >/dev/null 2>&1 || return 0
  USE_PAGER=true
}

print_fzf_command() {
  printf ' | fzf --exit-0 --preview'
  printf ' %q' "$FZF_PREVIEW_COMMAND"
  printf ' --bind'
  printf ' %q' 'enter:become(${VISUAL:-${EDITOR:-vi}} {})'
  printf '\n'
}

run_fzf() {
  command fzf --exit-0 \
    --preview "$FZF_PREVIEW_COMMAND" \
    --bind 'enter:become(${VISUAL:-${EDITOR:-vi}} {})'
}

run_search() {
  if $DEBUG; then
    print_engine_command
    if $USE_FZF; then
      print_fzf_command
    else
      printf '\n'
    fi
  elif $USE_FZF; then
    run_engine | run_fzf
  elif $USE_PAGER; then
    run_engine | LESS="${LESS:-FRX}" command less -R
  else
    run_engine
  fi
}

main() {
  load_project_arguments "$@"
  parse_arguments "${PROJECT_ARGUMENTS[@]}"
  build_fzf_preview_command
  classify_terms
  load_search_engine
  build_engine_arguments
  run_search
}

main "$@"
